#!/usr/bin/env bash
# Starts Postgres (Docker), the Phoenix API on :4000, the Next.js pay page on :3000, and
# the Flutter host app on the first connected Android device or running emulator.
# Set FLUTTER=/path/to/flutter when flutter is not on PATH (e.g. an fvm install).
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

if [[ ! -f .env ]]; then
  secret="$(openssl rand -base64 48 | tr -d '\n')"
  (umask 077 && sed "s|^SECRET_KEY_BASE=.*|SECRET_KEY_BASE=$secret|" .env.example > .env)
  echo "Created .env with a generated SECRET_KEY_BASE"
fi
set -a
. ./.env
set +a

docker compose up -d --wait db

(cd api && mix setup)
(cd web && pnpm install --frozen-lockfile)

pids=()
cleanup() {
  for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

(cd api && exec mix phx.server) &
pids+=($!)
(cd web && exec pnpm dev) &
pids+=($!)

flutter_bin="${FLUTTER:-flutter}"
android_device=""
if command -v "$flutter_bin" >/dev/null; then
  android_device="$("$flutter_bin" devices --machine 2>/dev/null | node -e '
    let s = "";
    process.stdin.on("data", (d) => (s += d)).on("end", () => {
      const devices = JSON.parse(s.slice(s.indexOf("[")) || "[]");
      const android = devices.find((d) => d.isSupported && d.targetPlatform.startsWith("android"));
      if (android) console.log(android.id);
    });
  ' || true)"
fi
if [[ -n "$android_device" ]]; then
  (cd app && exec "$flutter_bin" run -d "$android_device" </dev/null) &
  pids+=($!)
else
  echo "Flutter app not started: no flutter on PATH (set FLUTTER) or no Android device/emulator connected."
fi

wait
