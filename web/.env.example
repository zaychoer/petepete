# Public origin of the Petepete API, no trailing slash. Read by the pay page (/pay/<token>)
# and the join page (/join/<token>), on the server and in the browser, so it is baked in at
# build time: set it before `pnpm build`. The API must allow this site's origin (its
# WEB_BASE_URL) for the browser calls.
# Unset: development falls back to http://localhost:4000, production fails.
VITE_API_BASE_URL=http://localhost:4000

# Public Sentry DSN (optional). Unset or blank = Sentry disabled.
# VITE_SENTRY_DSN=
