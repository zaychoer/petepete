# Every environment variable the code reads. Copy to .env (gitignored); bin/dev does
# this on first run and generates the required values. Never commit .env.
# Commented-out variables are optional or production-only: leave them commented
# locally, because an empty value overrides the code's default.
# Production values are set with `fly secrets set` (secrets) or the [env] block of
# api/fly.*.toml (non-secret), never in files that hold real secrets.

# --- api, dev (required) ---
# Signs/encrypts Phoenix cookies and tokens. Generate with `openssl rand -base64 48`
# or `cd api && mix phx.gen.secret`.
SECRET_KEY_BASE=

# --- api, all environments (optional) ---
# HTTP port. Default 4000; fly.*.toml sets 8080.
# PORT=4000
# Start the HTTP server inside a release (bin/server sets this).
# PHX_SERVER=true

# --- api, test (optional) ---
# Suffix for the test database when splitting `mix test --partitions`.
# MIX_TEST_PARTITION=1

# --- api, prod only ---
# Fly secret: Postgres connection string, set when the database is attached.
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
# Fly secret: same purpose as in dev, different value per environment.
# SECRET_KEY_BASE=
# fly.*.toml [env]: public hostname used to build URLs.
# PHX_HOST=petepete-staging.fly.dev
# fly.*.toml [env]: "true" to reach Postgres over Fly's IPv6 private network.
# ECTO_IPV6=true
# Default 10.
# POOL_SIZE=10
# Fly secret: key for the OTP HMACs, at least 32 bytes (`openssl rand -base64 48`).
# Required: the app does not boot without it. Rotating it voids pending codes.
# OTP_HMAC_KEY=
# Fly secret or [env]: module name of the OTP delivery adapter, e.g.
# Elixir.Petepete.Accounts.OtpSender.<Provider>. Required: the app does not boot
# without it, and the dev/test fake is refused. No real adapter exists yet.
# OTP_SENDER=
# DNS query for clustering nodes; unset disables clustering.
# DNS_CLUSTER_QUERY=petepete-staging.internal
