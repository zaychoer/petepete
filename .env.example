# Local secrets template. Copy to .env (gitignored); bin/dev does this on first
# run and generates the values below. Never commit .env.
# Production values live in Fly secrets (`fly secrets set ...`), not in files.

# api: signs/encrypts Phoenix cookies and tokens in dev. Generate with
# `openssl rand -base64 48` or `cd api && mix phx.gen.secret`.
SECRET_KEY_BASE=
