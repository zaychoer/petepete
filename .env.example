# Every environment variable the code reads. Copy to .env (gitignored); bin/dev does
# this on first run and generates the required values. Never commit .env.
# Commented-out variables are optional or production-only: leave them commented
# locally, because an empty value overrides the code's default.
# Production values are set with `fly secrets set` (secrets) or the [env] block of
# api/fly.*.toml (non-secret), never in files that hold real secrets.

# --- api, dev (required) ---
# Signs/encrypts Phoenix cookies and tokens. Generate with `openssl rand -base64 48`
# or `cd api && mix phx.gen.secret`.
SECRET_KEY_BASE=

# --- api, all environments (optional) ---
# HTTP port. Default 4000; fly.*.toml sets 8080.
# PORT=4000
# Start the HTTP server inside a release (bin/server sets this).
# PHX_SERVER=true

# Sentry DSN for the API (Fly secret in prod). Unset or blank = Sentry disabled.
# SENTRY_DSN=
# Sentry environment name; fly.*.toml [env] sets staging / production.
# SENTRY_ENVIRONMENT=staging

# --- api, test (optional) ---
# Suffix for the test database when splitting `mix test --partitions`.
# MIX_TEST_PARTITION=1

# --- api, prod only ---
# Fly secret: Postgres connection string, set when the database is attached.
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
# Fly secret: same purpose as in dev, different value per environment.
# SECRET_KEY_BASE=
# fly.*.toml [env]: public hostname used to build URLs.
# PHX_HOST=petepete-staging.fly.dev
# fly.*.toml [env]: "true" to reach Postgres over Fly's IPv6 private network.
# ECTO_IPV6=true
# fly.*.toml [env]: payment gateway adapter, required, no default (boot fails without it).
# Only "fake" exists today, which is refused unless ALLOW_FAKE_ADAPTERS=true: staging sets
# both, production stays blocked until a real adapter lands. See docs/deploy.md, "Adapters".
# PAYMENT_GATEWAY=fake
# fly.staging.toml [env] only, never production: "true" lets the fake OTP sender and the
# fake gateway boot in a prod build. Anything else refuses them.
# ALLOW_FAKE_ADAPTERS=true
# Fly secret or [env]: public origin of the web app (no trailing path), used to build
# group invite links `<WEB_BASE_URL>/join/<token>`. Required: the app does not boot without it.
# WEB_BASE_URL=https://petepete-staging.vercel.app
# Default 10.
# POOL_SIZE=10
# Fly secret: key for the OTP HMACs, at least 32 bytes (`openssl rand -base64 48`).
# Required: the app does not boot without it. Rotating it voids pending codes.
# OTP_HMAC_KEY=
# Fly secret or [env]: module name of the OTP delivery adapter, e.g.
# Elixir.Petepete.Accounts.OtpSender.<Provider>. Required: the app does not boot
# without it, or when the module is not loadable or does not implement OtpSender; the
# fake (Elixir.Petepete.Accounts.OtpSender.Fake) is refused unless ALLOW_FAKE_ADAPTERS=true.
# No real adapter exists yet.
# OTP_SENDER=
# Fly secret, any non-test environment: bearer secret of GET /api/admin/metrics
# (the beta dashboard, docs/release.md). Unset or blank = the endpoint answers 404.
# Generate with `openssl rand -base64 32`.
# METRICS_TOKEN=
# DNS query for clustering nodes; unset disables clustering.
# DNS_CLUSTER_QUERY=petepete-staging.internal

# --- web (Vercel project env vars; see web/.env.example) ---
# Public origin of the API (no trailing slash), used by /pay/<token> and /join/<token>.
# Baked in at build time. The API allows browser calls from its WEB_BASE_URL origin only.
# Unset: dev falls back to http://localhost:4000, production fails.
# NEXT_PUBLIC_API_BASE_URL=https://petepete-staging.fly.dev
# Public Sentry DSN for the payment page. Unset or blank = Sentry disabled.
# NEXT_PUBLIC_SENTRY_DSN=

# --- app (Flutter; passed with --dart-define, not read from .env) ---
# flutter run/build --dart-define=SENTRY_DSN=<dsn> ; omitted = Sentry disabled.
# flutter run/build --dart-define=API_BASE_URL=https://<api-host> ; default
# http://10.0.2.2:4000 (the host machine as seen from the Android emulator).
